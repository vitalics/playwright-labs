{
  "name": "@playwright-labs/fixture-network",
  "version": "1.0.0",
  "description": "Network throttling fixtures for Playwright — useNetwork()/network handles with presets (2G/3G/4G/offline) and custom expect matchers",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "ci:pretest": "playwright install chromium",
    "package:pack": "pnpm exec npm pack",
    "package:pack:dry-run": "pnpm package:pack --dry-run"
  },
  "keywords": [
    "playwright",
    "fixture",
    "testing",
    "playwright-labs",
    "network",
    "throttling",
    "offline",
    "matchers"
  ],
  "author": "Vitali Haradkou <vitalicset@yandex.ru>",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitalics/playwright-labs.git",
    "directory": "packages/fixture-network"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "peerDependencies": {
    "@playwright/test": ">=1.57.0"
  },
  "dependencies": {
    "@playwright-labs/network-core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
