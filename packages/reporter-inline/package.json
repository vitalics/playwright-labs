{
  "name": "@playwright-labs/reporter-inline",
  "version": "0.1.0",
  "description": "Build a Playwright reporter from plain callbacks — no class required",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "build": "tsup",
    "package:pack": "pnpm exec npm pack",
    "package:pack:dry-run": "pnpm package:pack --dry-run"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "playwright-labs",
    "reporter",
    "inline",
    "callback"
  ],
  "author": "Vitali Haradkou <vitalicset@yandex.ru>",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "dependencies": {
    "@playwright-labs/reporter-core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.49.0"
  }
}
