{
  "name": "@playwright-labs/fixture-mailpit",
  "version": "0.0.0",
  "description": "Mailpit fixture integration for Playwright/test — find, read, send and delete emails via the Mailpit API",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "build": "tsup",
    "package:pack": "pnpm exec npm pack",
    "package:pack:dry-run": "pnpm package:pack --dry-run"
  },
  "keywords": [
    "playwright",
    "fixture",
    "mailpit",
    "email",
    "smtp",
    "automation",
    "testing",
    "playwright-labs"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "author": "Vitali Haradkou <vitalicset@yandex.ru>",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "devDependencies": {
    "@playwright/test": "1.57.0"
  },
  "peerDependencies": {
    "@playwright/test": "1.57.0"
  },
  "dependencies": {
    "@playwright-labs/email-core": "workspace:*"
  }
}
