{
  "name": "@playwright-labs/fixture-a11y",
  "version": "0.0.0",
  "description": "Accessibility testing fixture and toBeAccessible matcher for Playwright, powered by axe-core",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "ci:pretest": "playwright install",
    "package:pack": "pnpm exec npm pack",
    "package:pack:dry-run": "pnpm package:pack --dry-run",
    "dev": "vite"
  },
  "keywords": [
    "playwright",
    "fixture",
    "testing",
    "playwright-labs",
    "a11y",
    "accessibility",
    "axe",
    "axe-core",
    "wcag",
    "matchers"
  ],
  "author": "Vitali Haradkou <vitalicset@yandex.ru>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitalics/playwright-labs.git",
    "directory": "packages/fixture-a11y"
  },
  "packageManager": "pnpm@10.29.2",
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "peerDependencies": {
    "@playwright/test": ">=1.57.0"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright-labs/locators-extra": "workspace:*",
    "axe-core": "^4.13.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vite": "8.2.2"
  }
}
