{
  "name": "@playwright-labs/fixture-gmail",
  "version": "0.1.0",
  "description": "Gmail fixture integration for Playwright/test — find, read and send emails via the Gmail API",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "build": "tsup",
    "package:pack": "pnpm exec npm pack",
    "package:pack:dry-run": "pnpm package:pack --dry-run"
  },
  "keywords": [
    "playwright",
    "fixture",
    "gmail",
    "email",
    "gmail-api",
    "automation",
    "testing",
    "playwright-labs"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "author": "Vitali Haradkou <vitalicset@yandex.ru>",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "@types/nodemailer": "7.0.9"
  },
  "peerDependencies": {
    "@playwright/test": "1.57.0"
  },
  "dependencies": {
    "nodemailer": "9.0.1"
  }
}
