{
  "name": "@playwright-labs/network-core",
  "version": "0.0.0",
  "description": "Network condition emulation over CDP — presets (2G/3G/4G/DSL/WiFi/offline), condition factory, NetworkAPI with async-dispose",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
    "test": "playwright test",
    "typecheck": "tsc --noEmit",
    "package:pack": "pnpm exec npm pack",
    "package:pack:dry-run": "pnpm package:pack --dry-run"
  },
  "keywords": [
    "playwright",
    "network",
    "throttling",
    "cdp",
    "emulation",
    "offline",
    "playwright-labs"
  ],
  "author": "Vitali Haradkou <vitalicset@yandex.ru>",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vitalics/playwright-labs.git",
    "directory": "packages/network-core"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "peerDependencies": {
    "playwright-core": ">=1.57.0"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "playwright-core": "1.57.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  }
}
