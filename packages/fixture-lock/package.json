{
  "name": "@playwright-labs/fixture-lock",
  "version": "0.1.0",
  "description": "Cross-worker and cross-process resource locking for Playwright/test — pluggable HTTP, WebSocket, IPC and filesystem transports",
  "main": "dist/index.cjs",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "build": "tsup",
    "package:pack": "pnpm exec npm pack",
    "package:pack:dry-run": "pnpm package:pack --dry-run"
  },
  "keywords": [
    "playwright",
    "fixture",
    "lock",
    "mutex",
    "resource-lock",
    "concurrency",
    "automation",
    "testing",
    "playwright-labs"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./global-setup": {
      "import": {
        "types": "./dist/global-setup.d.ts",
        "default": "./dist/global-setup.mjs"
      },
      "require": {
        "types": "./dist/global-setup.d.cts",
        "default": "./dist/global-setup.cjs"
      }
    },
    "./global-teardown": {
      "import": {
        "types": "./dist/global-teardown.d.ts",
        "default": "./dist/global-teardown.mjs"
      },
      "require": {
        "types": "./dist/global-teardown.d.cts",
        "default": "./dist/global-teardown.cjs"
      }
    }
  },
  "author": "Vitali Haradkou <vitalicset@yandex.ru>",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "devDependencies": {
    "@playwright/test": "1.57.0"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.57.0"
  }
}
