{
  "name": "playwright-labs",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright Labs is a collection of packages that extend Playwright's functionality.",
  "scripts": {
    "test": "pnpm run -r --stream --parallel --color --if-present test",
    "build": "pnpm run -r --stream --color --if-present build",
    "package:pack:dry-run": "pnpm run -r --stream --color --if-present package:pack:dry-run",
    "ci:pretest": "pnpm --filter reporter-email-example exec playwright install-deps chromium && pnpm run -r --stream --color --if-present ci:pretest",
    "ci:release": "changeset",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile",
    "ci:publish": "changeset publish"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.29.2",
  "devDependencies": {
    "@changesets/cli": "2.29.8",
    "@types/node": "25.0.9",
    "tsup": "8.5.1",
    "tsx": "4.21.0"
  },
  "pnpm": {
    "overrides": {
      "protobufjs": "7.6.5",
      "rollup": "4.60.2",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@4.0.3": "4.0.4",
      "lodash": "4.18.1",
      "ajv": "8.18.0",
      "brace-expansion@2": "2.1.4",
      "brace-expansion@5": "5.0.9",
      "next": "16.2.11",
      "dockerode>uuid": "14.0.0",
      "uuid@8": "11.1.1",
      "fast-uri": "3.1.6",
      "nanoid@3": "3.3.18",
      "postcss": "8.5.23",
      "ws": "8.21.0",
      "sharp": "0.35.0",
      "@opentelemetry/propagator-jaeger": "2.9.0",
      "@opentelemetry/core": "2.9.0",
      "@grpc/grpc-js": "1.14.4",
      "engine.io": "6.6.7",
      "js-yaml@3": "3.15.1",
      "js-yaml@4": "4.3.1",
      "file-type@16": "21.3.4",
      "tmp": "0.2.7",
      "undici@7": "7.29.0",
      "esbuild@0.27.3": "0.28.1",
      "socket.io-parser": "4.2.7"
    }
  }
}
